+/* Keep the Windows titlebar strip clear above the browser, just as above chat.
+   Frost a separate paint layer: filtering the section itself creates a stacking
+   context and traps the macOS tab strip below the window's drag region. */
+html[data-glass][data-chat-wallpaper-workspace-ready] [data-slot="browser-panel"] {
+  background: transparent;
+}
+html[data-glass][data-chat-wallpaper-workspace-ready] [data-slot="browser-panel"]::before {
+  content: "";
+  position: absolute;
+  inset: var(--studio-custom-titlebar-height, 0px) 0 0;
+  pointer-events: none;
+  background-color: color-mix(in srgb, var(--glass-panel-fill) min(96%, calc(max(var(--glass-tint), var(--glass-pane-floor)) * var(--glass-opacity, 1))), transparent);
+  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+  backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
+}
+/* Web chrome shares the glass layer; pages and file previews retain their
+   opaque canvases, including the document toolbar's surface token. */
+html[data-glass][data-chat-wallpaper-workspace-ready] [data-slot="browser-panel"]:not([data-browser-document]) > .browser-panel-body {
+  background-color: transparent;
+}
+html[data-glass^="liquid"][data-chat-wallpaper-workspace-ready] [data-slot="browser-panel"]::before {
+  background-image: var(--glass-sheen);
+}
